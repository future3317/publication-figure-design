{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "publication-figure-design/rule.schema.json",
  "title": "Publication Figure Design rule",
  "type": "object",
  "required": ["id", "title", "scope", "severity", "statement", "verification", "authority", "rationale"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "scope": {"enum": ["global", "house", "journal", "family", "backend", "eval"]},
    "severity": {"enum": ["block", "warn", "advisory"]},
    "statement": {"type": "string", "minLength": 1},
    "applicability": {"type": "object"},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "verification": {
      "type": "object",
      "required": ["mode", "checks"],
      "properties": {
        "mode": {"enum": ["automated", "manual", "hybrid"]},
        "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "authority": {"enum": ["normative", "publisher_requirement", "scientific_integrity", "evidence_based_guidance", "house_style", "heuristic"]},
    "rationale": {"type": "string", "minLength": 1},
    "override": {"type": "object"},
    "conflicts_with": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
